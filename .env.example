# ── Supabase (public) ────────────────────────────────────────
# Find these in your Supabase project: Settings → API.
# These are safe for the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (server-only, REQUIRED for trusted advisor provisioning) ──
# SUPABASE_SERVICE_ROLE_KEY is a SECRET. Never prefix it with NEXT_PUBLIC_,
# never commit it (keep it only in .env.local / your secret store), and never
# send it to the browser or client-side code.
# Local mapping from `pnpm exec supabase status -o env`:
#   API_URL          -> SUPABASE_URL (also NEXT_PUBLIC_SUPABASE_URL)
#   SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY
# Copy the values into .env.local manually; do not print or commit them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── App (required, server-side) ──────────────────────────────
# Absolute app URL, used server-side for auth redirects and recovery links.
APP_URL=http://localhost:3000
